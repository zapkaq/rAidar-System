@{
    ViewData["Title"] = "About";
}

<!-- Page Header -->
<section class="py-5 bg-primary text-white">

    <div class="container text-center">

        <h1 class="display-4 fw-bold">
            About rAIdar
        </h1>

        <p class="lead">
            Real-Time AI-Powered Deepfake and Synthetic Media Detection Platform
        </p>

    </div>

</section>

<!-- Overview -->
<section class="py-5">

    <div class="container">

        <div class="row">

            <div class="col-lg-6">

                <h2 class="fw-bold mb-4">
                    Project Overview
                </h2>

                <p class="text-muted">
                    rAIdar is a web-based application developed to detect AI-generated
                    and manipulated facial images using a Convolutional Neural Network
                    (CNN). The platform enables users to upload images for analysis
                    and receive real-time predictions indicating whether an image is
                    authentic or AI-generated, along with a confidence score.
                </p>

            </div>

            <div class="col-lg-6">

                <h2 class="fw-bold mb-4">
                    Objectives
                </h2>

                <ul class="text-muted">

                    <li>Detect AI-generated facial images.</li>

                    <li>Provide real-time image analysis.</li>

                    <li>Display confidence scores for every prediction.</li>

                    <li>Support research on AI-generated media.</li>

                </ul>

            </div>

        </div>

    </div>

</section>

<!-- Technologies -->

<section class="py-5 bg-light">

    <div class="container">

        <div class="text-center mb-5">

            <h2 class="fw-bold">

                Technologies Used

            </h2>

        </div>

        <div class="row g-4">

            <div class="col-md-3">

                <div class="card shadow-sm h-100">

                    <div class="card-body text-center">

                        <h1>💻</h1>

                        <h5>ASP.NET Core MVC</h5>

                        <p class="text-muted">

                            User interface and application logic.

                        </p>

                    </div>

                </div>

            </div>

            <div class="col-md-3">

                <div class="card shadow-sm h-100">

                    <div class="card-body text-center">

                        <h1>🐍</h1>

                        <h5>Flask API</h5>

                        <p class="text-muted">

                            Connects the web application to the AI model.

                        </p>

                    </div>

                </div>

            </div>

            <div class="col-md-3">

                <div class="card shadow-sm h-100">

                    <div class="card-body text-center">

                        <h1>🧠</h1>

                        <h5>TensorFlow CNN</h5>

                        <p class="text-muted">

                            Performs deepfake image classification.

                        </p>

                    </div>

                </div>

            </div>

            <div class="col-md-3">

                <div class="card shadow-sm h-100">

                    <div class="card-body text-center">

                        <h1>🗄️</h1>

                        <h5>SQL Server</h5>

                        <p class="text-muted">

                            Stores user accounts and detection history.

                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- Workflow -->

<section class="py-5">

    <div class="container">

        <div class="text-center mb-5">

            <h2 class="fw-bold">

                How rAIdar Works

            </h2>

        </div>

        <div class="row text-center">

            <div class="col-md-3">

                <div class="display-4">📤</div>

                <h5>Upload</h5>

                <p class="text-muted">
                    Upload a facial image.
                </p>

            </div>

            <div class="col-md-3">

                <div class="display-4">⚙️</div>

                <h5>Preprocess</h5>

                <p class="text-muted">
                    Resize and normalize the image.
                </p>

            </div>

            <div class="col-md-3">

                <div class="display-4">🤖</div>

                <h5>Analyze</h5>

                <p class="text-muted">
                    CNN extracts image features and predicts authenticity.
                </p>

            </div>

            <div class="col-md-3">

                <div class="display-4">📊</div>

                <h5>Results</h5>

                <p class="text-muted">
                    Display prediction and confidence score.
                </p>

            </div>

        </div>

    </div>

</section>

<!-- Developers -->

<section class="py-5 bg-light">

    <div class="container text-center">

        <h2 class="fw-bold mb-4">

            Development Team

        </h2>

        <p class="text-muted">

            This system was developed as a capstone research project entitled
            <strong>rAIdar: Real-Time AI-Powered Deepfake and Synthetic Media Detection Platform</strong>.

        </p>

    </div>

</section>
```
