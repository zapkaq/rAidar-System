
@model List<rAIdar.Models.AppUser>

@{
    ViewData["Title"] = "Manage Users";

    var totalUsers = Model?.Count ?? 0;
    var activeUsers = Model?.Count(u => u.IsActive) ?? 0;
    var inactiveUsers = totalUsers - activeUsers;
}

<div class="raidar-page">
    <div class="container py-5">

        <!-- Page Header -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div>
                <span class="raidar-eyebrow">ADMINISTRATION</span>
                <h2 class="raidar-page-title mt-2">Manage Users</h2>
                <p class="raidar-page-subtitle mb-0">
                    View registered accounts and manage their access.
                </p>
            </div>

            <a asp-controller="Admin"
               asp-action="Dashboard"
               class="btn raidar-outline-btn">
                <i class="bi bi-arrow-left me-2"></i>
                Back to Dashboard
            </a>
        </div>

        <!-- User Statistics -->
        <div class="row g-3 mb-4">

            <div class="col-md-4">
                <div class="raidar-stat-card">
                    <div class="raidar-stat-icon blue">
                        <i class="bi bi-people"></i>
                    </div>
                    <div>
                        <div class="raidar-stat-label">Total Users</div>
                        <div class="raidar-stat-value">@totalUsers</div>
                        <div class="raidar-stat-description">Registered accounts</div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="raidar-stat-card">
                    <div class="raidar-stat-icon green">
                        <i class="bi bi-person-check"></i>
                    </div>
                    <div>
                        <div class="raidar-stat-label">Active Users</div>
                        <div class="raidar-stat-value">@activeUsers</div>
                        <div class="raidar-stat-description">Accounts with active status</div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="raidar-stat-card">
                    <div class="raidar-stat-icon red">
                        <i class="bi bi-person-x"></i>
                    </div>
                    <div>
                        <div class="raidar-stat-label">Inactive Users</div>
                        <div class="raidar-stat-value">@inactiveUsers</div>
                        <div class="raidar-stat-description">Deactivated accounts</div>
                    </div>
                </div>
            </div>

        </div>

        <!-- User Management Table -->
        <div class="raidar-panel">

            <div class="raidar-panel-header">
                <div>
                    <h5 class="mb-1">Registered Accounts</h5>
                    <p class="mb-0">Review account information and manage user status.</p>
                </div>

                <span class="raidar-count-badge">
                    @totalUsers Users
                </span>
            </div>

            <!-- Search -->
            <div class="raidar-search-area">
                <div class="raidar-search-box">
                    <i class="bi bi-search"></i>
                    <input type="text"
                           id="userSearch"
                           class="form-control"
                           placeholder="Search by name, username, or email..."
                           autocomplete="off" />
                </div>
            </div>

            <div class="table-responsive">
                <table class="table raidar-table align-middle mb-0" id="usersTable">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>USER INFORMATION</th>
                            <th>EMAIL ADDRESS</th>
                            <th>ROLE</th>
                            <th class="text-center">TOTAL SCANS</th>
                            <th>STATUS</th>
                            <th class="text-end">ACTION</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var user in Model)
                            {
                                <tr class="user-row">
                                    <td class="text-muted">
                                        #@user.UserId
                                    </td>

                                    <td>
                                        <div class="raidar-user-info">
                                            <div class="raidar-avatar">
                                                @(string.IsNullOrWhiteSpace(user.FullName)
                                                    ? "U"
                                                    : user.FullName.Substring(0, 1).ToUpper())
                                            </div>

                                            <div>
                                                <div class="raidar-user-name">
                                                    @user.FullName
                                                </div>
                                                <div class="raidar-user-username">
                                                    @@@user.Username
                                                </div>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="raidar-email">@user.Email</span>
                                    </td>

                                    <td>
                                        <span class="raidar-role">
                                            @user.Role
                                        </span>
                                    </td>

                                    <td class="text-center">
                                        <span class="raidar-scan-count">
                                            @(user.DetectionHistories?.Count ?? 0)
                                        </span>
                                    </td>

                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="raidar-status active">
                                                <span></span> Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="raidar-status inactive">
                                                <span></span> Inactive
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        <form asp-controller="Admin"
                                              asp-action="ToggleUserStatus"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('@(user.IsActive ? "Deactivate" : "Activate") this user account?');">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@user.UserId" />

                                            @if (user.IsActive)
                                            {
                                                <button type="submit"
                                                        class="btn raidar-action-btn deactivate">
                                                    <i class="bi bi-person-dash me-1"></i>
                                                    Deactivate
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="btn raidar-action-btn activate">
                                                    <i class="bi bi-person-check me-1"></i>
                                                    Activate
                                                </button>
                                            }
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <i class="bi bi-people raidar-empty-icon"></i>
                                    <h6 class="mt-3">No registered users found</h6>
                                    <p class="text-muted mb-0">
                                        User accounts will appear here when available.
                                    </p>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

                <div id="noSearchResults" class="raidar-no-results" style="display:none;">
                    <i class="bi bi-search"></i>
                    <p class="mb-0">No users match your search.</p>
                </div>
            </div>

            <div class="raidar-panel-footer">
                Showing <strong id="visibleUserCount">@totalUsers</strong>
                of <strong>@totalUsers</strong> registered users
            </div>

        </div>

    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("userSearch");
            const rows = document.querySelectorAll("#usersTable tbody .user-row");
            const visibleCount = document.getElementById("visibleUserCount");
            const noResults = document.getElementById("noSearchResults");

            if (!searchInput) return;

            searchInput.addEventListener("input", function () {
                const searchValue = this.value.toLowerCase().trim();
                let visible = 0;

                rows.forEach(function (row) {
                    const rowText = row.textContent.toLowerCase();
                    const matches = rowText.includes(searchValue);

                    row.style.display = matches ? "" : "none";

                    if (matches) visible++;
                });

                visibleCount.textContent = visible;
                noResults.style.display =
                    rows.length > 0 && visible === 0 ? "block" : "none";
            });
        });
    </script>
}
